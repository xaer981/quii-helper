__pycache__/
venv/
.venv/
.env
.env.*
!.env.example
build/
dist/
*.egg-info/
.coverage
htmlcov/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Extracted APK certs, private keys, and native libraries must stay local.
assets/*
!assets/.gitkeep

# Keep the runtime output directory in git, but ignore generated artifacts.
!data/
data/*
!data/.gitkeep

*.bin
*.mp4
*.jpg
*.h264
*.jsonl
*.log
gitleaks-*.json
gitleaks-*.sarif

# Minimal LAN secrets saved explicitly by the stream-key bootstrap example.
stream_credentials.json
.stream_credentials.json.*
