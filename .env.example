# LAN-only is the default. Cloud/P2P operations require an explicit 'cloud'.
# snapshot(), save_video() and serve_rtsp() use the supplied LAN credentials.
CAMERA_CONNECTION_MODE=lan
CAMERA_DEVICE_HOST=""
CAMERA_STREAM_PORT=34567
# Saved stream key: exactly 32 UTF-8 bytes, not hex/base64-decoded.
# Never fetched or renewed automatically in LAN-only mode.
# Explicit bootstrap: Camera.fetch_stream_credentials() in cloud mode.
# See python -m examples.cloud_key_rtsp; its saved JSON is loaded explicitly,
# not automatically merged into .env or Camera().
# Later starts: python -m examples.lan_rtsp loads the JSON without cloud calls.
# The other media examples use STREAM_KEY / AUTH_CODE from configuration.
STREAM_KEY=""

# Mobile-app account credentials (used only in explicit cloud mode).
# CLOUD_USERNAME is also accepted as a legacy
# alias for CLOUD_ACCOUNT.
CLOUD_ACCOUNT=""
CLOUD_PASSWORD=""
DEVICE_ID=""

# Stable per-install client id. Generate one with:
# python -c "import uuid; print(uuid.uuid4().hex)"
CLOUD_CLIENT_UUID=""

# Extract the service URL and app identity from the APK first. With the TLS
# assets, service URL, OEM, and UUID in place, the checkout helper
# python -m examples.discover_env_values prints CLOUD_AUTH_URL and IP_REGION_ID.
CLOUD_AUTH_URL=""
CLOUD_SERVICE_URL=""
CAMERA_OEM=""
CAMERA_APP_ID=
CAMERA_CLIENT_TYPE=
IP_REGION_ID=
CLOUD_AUTH_VERSION=""

# Video-panel input. On the tested Tantos: 1 = outdoor, 2 = indoor.
CAMERA_CHANNEL=1
# Profile: high/main/1 = main (higher quality), low/sub/2 = lower bandwidth.
# Other positive ids are accepted; profiles/resolution depend on firmware.
# Default is low (stream 2). Explicit Camera arguments override these values.
CAMERA_STREAM=low

# AUTH_CODE is required by LAN TCP playback and local /tdkcgi helpers.
# A raw auth code or its already encoded value is accepted by LAN TCP.
AUTH_CODE=""
DEVICE_PASSWORD=""

# Required only by Camera.open_door(). This is the door-opening password,
# separate from AUTH_CODE, DEVICE_PASSWORD, and CLOUD_PASSWORD.
UNLOCK_PASSWORD=""  # Optional.

TLS_VERIFY=true
LOG_LEVEL=info
