# Mobile-app account credentials. CLOUD_USERNAME is also accepted as a legacy
# alias for CLOUD_ACCOUNT.
CLOUD_ACCOUNT=""
CLOUD_PASSWORD=""
DEVICE_ID=""
CAMERA_DEVICE_HOST=""

# Stable per-install client id. Generate one with:
# python -c "import uuid; print(uuid.uuid4().hex)"
CLOUD_CLIENT_UUID=""

# Extract the service URL and app identity from the APK first. With the TLS
# assets, service URL, OEM, and UUID in place, the checkout helper
# python -m examples.discover_env_values prints CLOUD_AUTH_URL and IP_REGION_ID.
CLOUD_AUTH_URL=""
CLOUD_SERVICE_URL=""
CAMERA_OEM=""
CAMERA_APP_ID=
CAMERA_CLIENT_TYPE=
IP_REGION_ID=
CLOUD_AUTH_VERSION=""

# Default video-panel channel and stream (1 = high, 2 = low on the tested device).
CAMERA_CHANNEL=1
CAMERA_STREAM=2

# Optional. AUTH_CODE is used by local /tdkcgi helpers and TCP/CGI
# probe helpers, not by the normal cloud/P2P preview flow.
AUTH_CODE=""
DEVICE_PASSWORD=""

# Required only by Camera.open_door(). This is the door-opening password,
# separate from AUTH_CODE, DEVICE_PASSWORD, and CLOUD_PASSWORD.
UNLOCK_PASSWORD=""  # Optional.

TLS_VERIFY=true
LOG_LEVEL=info
