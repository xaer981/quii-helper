# Mobile-app account credentials. CLOUD_USERNAME is also accepted as a legacy
# alias for CLOUD_ACCOUNT.
CLOUD_ACCOUNT=""
CLOUD_PASSWORD=""
DEVICE_ID=""
CAMERA_DEVICE_HOST=""

# Stable per-install client id. Generate one with:
# python -c "import uuid; print(uuid.uuid4().hex)"
CLOUD_CLIENT_UUID=""

# Camera/app identity and cloud endpoints extracted from the APK or discovered
# with: python -m examples.discover_env_values
CLOUD_AUTH_URL=""
CLOUD_SERVICE_URL=""
CAMERA_OEM=""
CAMERA_APP_ID=
CAMERA_CLIENT_TYPE=
IP_REGION_ID=
CLOUD_AUTH_VERSION=""

CAMERA_CHANNEL=1
CAMERA_STREAM=2

# Optional. AUTH_CODE is used by local read-only /tdkcgi helpers and TCP/CGI
# probe helpers, not by the normal cloud/P2P preview flow.
AUTH_CODE=""
DEVICE_PASSWORD=""

TLS_VERIFY=true
LOG_LEVEL=info
